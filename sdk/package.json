{
  "name": "opensend-js",
  "version": "0.2.5",
  "description": "TypeScript SDK for the self-hosted OpenSend email API",
  "type": "module",
  "engines": { "node": ">=20" },
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "opensend": "./dist/cli.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./client": { "types": "./dist/client/index.d.ts", "import": "./dist/client/index.js" },
    "./upload": { "types": "./dist/upload.d.ts", "import": "./dist/upload.js" }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/R44VC0RP/opensend.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/R44VC0RP/opensend/tree/main/sdk#readme",
  "bugs": { "url": "https://github.com/R44VC0RP/opensend/issues" },
  "keywords": ["opensend", "email", "ses", "sdk", "typescript", "self-hosted"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "devDependencies": { "@types/node": "^26.5.0", "typescript": "^6.0.3" }
}
