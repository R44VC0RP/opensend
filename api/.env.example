# Local Node/Docker defaults. Fill secrets locally; never commit .env.
ADMIN_API_KEY=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgres://opensend:REPLACE_PASSWORD@127.0.0.1:55432/opensend
PUBLIC_URL=http://127.0.0.1:8793
API_BASE_URL=http://127.0.0.1:8793
PORT=8793
HOST=127.0.0.1
WORKSPACE_ID=default
SES_REGIONS=us-east-1
ENABLE_LIVE_SES=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SNS_TOPIC_ARNS=
# Reserved host for paused acceptance fixtures; replace with trusted real hosts in production.
WEBHOOK_ALLOWED_HOSTS=example.com
SES_TRANSACTIONAL_CONFIGURATION_SET=opensend-transactional
SES_MARKETING_CONFIGURATION_SET=opensend-marketing
S3_BUCKET=opensend-attachments
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:59000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
