# Copy to .env; fill locally and never commit secrets.
# Docker dashboard + API origin. For Vite development use http://127.0.0.1:5173.
PUBLIC_URL=http://127.0.0.1:8793
# Root secret: generate at least 32 random bytes (for example 64 hex characters).
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated exact Google email addresses OR exact Google Workspace hd domains.
# Missing/empty allowlists deny sign-in. Personal Gmail requires an explicit email.
# All approved users are administrators. Never use a wildcard or gmail.com domain.
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_DOMAINS=
# Optional only during rotation; not a fallback for old login sessions.
# PREVIOUS_BETTER_AUTH_SECRET=

# Local Postgres: use the same generated password in both values.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://opensend:REPLACE_PASSWORD@127.0.0.1:55432/opensend
PORT=8793
HOST=127.0.0.1
# Direct API origin for local acceptance, not the browser/Google callback origin.
API_BASE_URL=http://127.0.0.1:8793

# Start in simulated mode. Test API keys never call SES.
ENABLE_LIVE_SES=false
SES_REGIONS=us-east-1
SES_TRANSACTIONAL_CONFIGURATION_SET=opensend-transactional
SES_MARKETING_CONFIGURATION_SET=opensend-marketing
# Prefer an IAM workload identity on Node where available; do not store AWS keys in UI.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Required with SNS_TOPIC_ARNS: actual SES sending account, not just topic owner.
AWS_ACCOUNT_ID=
SNS_TOPIC_ARNS=
# Exact administrator-approved public webhook hosts. Empty denies outbound webhooks.
WEBHOOK_ALLOWED_HOSTS=

# Private bucket. MinIO uses these credentials locally; provision the bucket once.
S3_BUCKET=opensend-attachments
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:59000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
