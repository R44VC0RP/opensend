# Copy to .env; fill locally and never commit secrets.
# Docker dashboard + API origin. For Vite development use http://127.0.0.1:5173.
PUBLIC_URL=http://127.0.0.1:8793
# Optional public SNS callback while dashboard/Google login remains local.
# Example: https://YOUR-TUNNEL/v1/events/ses
SES_FEEDBACK_URL=
# Root secret: generate at least 32 random bytes (for example 64 hex characters).
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated exact Google email addresses OR exact Google Workspace hd domains.
# Missing/empty allowlists deny sign-in. Personal Gmail requires an explicit email.
# All approved users are administrators. Never use a wildcard or gmail.com domain.
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_DOMAINS=
# Optional only during rotation; not a fallback for old login sessions.
# PREVIOUS_BETTER_AUTH_SECRET=

# Local Postgres: use the same generated password in both values.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://opensend:REPLACE_PASSWORD@127.0.0.1:55432/opensend
PORT=8793
HOST=127.0.0.1
# Direct API origin for local acceptance, not the browser/Google callback origin.
API_BASE_URL=http://127.0.0.1:8793

# Prevent live mail initially; does NOT block read-only discovery or explicit AWS provisioning.
# Test keys never call AWS. Discovery/provisioning require unrestricted live access.
ENABLE_LIVE_SES=false
# Test sends always use the full SES dispatch path with an in-process transport.
# These optional values default to 100 ms, 1,000 recipients/s, and 250 ms.
# SIMULATED_SES_LATENCY_MS=100
# SIMULATED_SES_RATE=1000
# SIMULATED_SES_DELIVERY_DELAY_MS=250
# Seeds the database default once during migration; manage regions through the API afterward.
DEFAULT_SES_REGION=us-east-1
# Explicit server-only IAM credentials; no automatic role lookup or temporary-token renewal.
# Keep keys out of the UI. Account/topic trust and configuration-set names are derived, not env inputs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary credentials.
AWS_SESSION_TOKEN=
# AWS provisioning requires a public HTTPS PUBLIC_URL (use a tunnel/public host locally).
# Update the Google OAuth origin and callback to match; localhost/127.0.0.1 cannot receive SNS.
# Exact administrator-approved public webhook hosts. Empty denies outbound webhooks.
WEBHOOK_ALLOWED_HOSTS=

# Private bucket. MinIO uses these credentials locally; provision the bucket once.
S3_BUCKET=opensend-attachments
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:59000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
