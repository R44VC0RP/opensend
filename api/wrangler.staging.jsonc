// OpenSend MX staging: a separate installation that shares no data, queues, secrets or AWS
// principal with production. Queues, the attachment bucket and Hyperdrive come from infra/
// (tofu, staging.tfvars); deploy with `npx wrangler deploy --config wrangler.staging.jsonc`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opensend-mx-staging",
  "account_id": "15d29c8639fd3733b1b5486a2acfd968",
  "workers_dev": false,
  "routes": [{ "pattern": "staging.opensend.mx", "custom_domain": true }],
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "@aws-sdk/xml-builder": "@aws-sdk/xml-builder/dist-cjs/index.js" },
  "assets": {
    "directory": "../app/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1", "/v1/*", "/mailbox/*", "/api", "/api/*", "/mcp", "/mcp/*", "/.well-known", "/.well-known/*", "/unsubscribe", "/unsubscribe/*", "/health", "/openapi.json", "/docs.md", "/docs/operations/*", "/llms.txt"]
  },
  "vars": {
    "PUBLIC_URL": "https://staging.opensend.mx",
    "DEFAULT_SES_REGION": "us-east-1",
    // Simulated SES only until staging has its own AWS account.
    "ENABLE_LIVE_SES": "false",
    "JOB_CONCURRENCY": "6",
    "SIMULATED_SES_LATENCY_MS": "170",
    "SIMULATED_SES_RATE": "5000",
    "DISPATCH_SHARDS": "4",
    "DISPATCH_RATE_FACTOR": "1.1",
    "WEBHOOK_ALLOWED_HOSTS": "",
    "AUTH_ALLOWED_DOMAINS": "anoma.ly",
    "API_RATE_LIMIT_PER_MINUTE": "10000",
    "WORK_QUEUE_NAME": "opensend-mx-staging-work",
    "FEEDBACK_QUEUE_NAME": "opensend-mx-staging-feedback"
  },
  "durable_objects": { "bindings": [{ "name": "DISPATCHER", "class_name": "DispatcherShard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DispatcherShard"] }],
  // `tofu output hyperdrive_id` once the staging database exists.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "opensend-mx-staging-attachments" }],
  "queues": {
    "producers": [
      { "binding": "WAKE_QUEUE", "queue": "opensend-mx-staging-work" },
      { "binding": "FEEDBACK_QUEUE", "queue": "opensend-mx-staging-feedback" }
    ],
    "consumers": [
      { "queue": "opensend-mx-staging-work", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3, "max_concurrency": 8 },
      { "queue": "opensend-mx-staging-feedback", "max_batch_size": 100, "max_batch_timeout": 2, "max_retries": 5, "max_concurrency": 10 }
    ]
  },
  "triggers": { "crons": ["* * * * *", "7 * * * *"] },
  // Rate limiter namespaces are per account; production uses 8793001.
  "ratelimits": [{ "name": "ADMISSION", "namespace_id": "8793101", "simple": { "limit": 6000, "period": 60 } }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
