// OpenSend MX (opensend.mx): a multi-tenant installation with its own data, queues, secrets and
// AWS principal. Queues, the attachment bucket and Hyperdrive come from infra/ (tofu,
// production.tfvars); deployed by .github/workflows/deploy-mx.yml.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opensend-mx",
  "account_id": "15d29c8639fd3733b1b5486a2acfd968",
  "workers_dev": false,
  "routes": [{ "pattern": "opensend.mx", "custom_domain": true }],
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "@aws-sdk/xml-builder": "@aws-sdk/xml-builder/dist-cjs/index.js" },
  "assets": {
    "directory": "../app/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1", "/v1/*", "/api", "/api/*", "/mcp", "/mcp/*", "/.well-known", "/.well-known/*", "/unsubscribe", "/unsubscribe/*", "/health", "/openapi.json", "/docs.md", "/docs/operations/*", "/llms.txt"]
  },
  "vars": {
    "PUBLIC_URL": "https://opensend.mx",
    "MULTI_TENANT": "true",
    // Bring-your-own AWS CloudFormation template, published from api/byo-template.yaml (public, versioned).
    "BYO_TEMPLATE_URL": "https://opensend-mx-templates.s3.us-east-2.amazonaws.com/byo/v4.yaml",
    "DEFAULT_SES_REGION": "us-east-2",
    // Live SES uses the shared-account key (infra/aws-shared). Sends stay denied by its IAM policy
    // until every send carries an SES TenantName.
    "ENABLE_LIVE_SES": "true",
    "JOB_CONCURRENCY": "6",
    "SIMULATED_SES_LATENCY_MS": "170",
    "SIMULATED_SES_RATE": "5000",
    "DISPATCH_SHARDS": "4",
    "DISPATCH_RATE_FACTOR": "1.1",
    "API_RATE_LIMIT_PER_MINUTE": "10000",
    "WORK_QUEUE_NAME": "opensend-mx-production-work",
    "FEEDBACK_QUEUE_NAME": "opensend-mx-production-feedback"
  },
  "durable_objects": { "bindings": [{ "name": "DISPATCHER", "class_name": "DispatcherShard" }] },
  // Run HTTP requests next to the opensend-public database (PlanetScale aws-us-east-2), as production does.
  "placement": { "region": "aws:us-east-2" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DispatcherShard"] }],
  // From `tofu output hyperdrive_id` (infra/, production state).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "3742f44f5c9344fd8e7c99b7b08b84cf" }],
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "opensend-mx-production-attachments" }],
  "queues": {
    "producers": [
      { "binding": "WAKE_QUEUE", "queue": "opensend-mx-production-work" },
      { "binding": "FEEDBACK_QUEUE", "queue": "opensend-mx-production-feedback" }
    ],
    "consumers": [
      { "queue": "opensend-mx-production-work", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3, "max_concurrency": 8 },
      { "queue": "opensend-mx-production-feedback", "max_batch_size": 100, "max_batch_timeout": 2, "max_retries": 5, "max_concurrency": 10 }
    ]
  },
  "triggers": { "crons": ["* * * * *", "7 * * * *"] },
  // Rate limiter namespaces are per account; production uses 8793001.
  "ratelimits": [{ "name": "ADMISSION", "namespace_id": "8793101", "simple": { "limit": 6000, "period": 60 } }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
