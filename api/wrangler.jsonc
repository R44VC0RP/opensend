{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opensend-api",
  "account_id": "15d29c8639fd3733b1b5486a2acfd968",
  "workers_dev": false,
  "routes": [{ "pattern": "opensend.anoma.ly", "custom_domain": true }],
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  // Workers have no DOMParser; use the SDK's bundled non-browser XML parser for STS/SNS.
  "alias": { "@aws-sdk/xml-builder": "@aws-sdk/xml-builder/dist-cjs/index.js" },
  "assets": {
    "directory": "../app/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1", "/v1/*", "/api", "/api/*", "/mcp", "/mcp/*", "/.well-known", "/.well-known/*", "/unsubscribe", "/unsubscribe/*", "/health", "/openapi.json", "/docs.md", "/docs/operations/*", "/llms.txt"]
  },
  "vars": {
    "PUBLIC_URL": "https://opensend.anoma.ly",
    "DEFAULT_SES_REGION": "us-east-2",
    "ENABLE_LIVE_SES": "true",
    "JOB_CONCURRENCY": "6",
    // Test-environment dispatch uses the in-process SES transport; match measured live SES latency
    // and make the simulated quota the throughput target so benchmarks measure the pipeline, not the gate.
    "SIMULATED_SES_LATENCY_MS": "170",
    "SIMULATED_SES_RATE": "5000",
    // Dispatcher shards per environment/region; each owns 1/N of the regional send quota.
    "DISPATCH_SHARDS": "4",
    // Aim 10% above the SES quota (22/s at a 20/s quota) to keep it saturated; any 429 brakes back to the quota for ten seconds.
    "DISPATCH_RATE_FACTOR": "1.1",
    "WEBHOOK_ALLOWED_HOSTS": ""
  },
  // One long-lived dispatcher per environment/region/shard, placed near the database.
  "durable_objects": { "bindings": [{ "name": "DISPATCHER", "class_name": "DispatcherShard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DispatcherShard"] }],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "fe48d8b8b9294750a362eb8145186752" }],
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "opensend-attachments" }],
  "queues": {
    "producers": [
      { "binding": "WAKE_QUEUE", "queue": "opensend-work" },
      // Verified provider feedback and test-mode simulated callbacks; ingested in batches, never via the jobs table.
      { "binding": "FEEDBACK_QUEUE", "queue": "opensend-feedback" }
    ],
    "consumers": [
      { "queue": "opensend-work", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3, "max_concurrency": 8 },
      { "queue": "opensend-feedback", "max_batch_size": 100, "max_batch_timeout": 2, "max_retries": 5, "max_concurrency": 10 }
    ]
  },
  "triggers": { "crons": ["* * * * *", "7 * * * *"] },
  "ratelimits": [{ "name": "ADMISSION", "namespace_id": "8793001", "simple": { "limit": 6000, "period": 60 } }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
