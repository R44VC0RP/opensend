{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Deny", "Action": ["sns:*Topic*", "sns:*Tag*", "sns:Subscribe", "ses:*Identity*", "ses:*Tenant*", "ses:*ConfigurationSet*", "ses:TagResource", "ses:SendEmail", "ses:*Reputation*"],
      "NotResource": ["arn:aws:ses:us-east-1:YOUR_AWS_ACCOUNT_ID:*", "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:*", "arn:aws:sns:us-east-1:YOUR_AWS_ACCOUNT_ID:*", "arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:*", "arn:aws:ses:us-east-1:aws:reputation-policy/strict", "arn:aws:ses:us-east-2:aws:reputation-policy/strict"]
    },
    {
      "Effect": "Deny", "NotAction": "sts:AssumeRole", "Resource": "*",
      "Condition": {"StringNotEquals": {"aws:RequestedRegion": ["us-east-1", "us-east-2"]}}
    },
    {
      "Effect": "Deny", "Action": ["s3:*", "ses:*ReceiptRule*"], "Resource": "*",
      "Condition": {"StringNotEquals": {"aws:RequestedRegion": "us-east-2"}}
    },
    {
      "Effect": "Deny", "NotAction": "ses:SendEmail", "Resource": "arn:aws:ses:*:*:identity/*@*"
    },
    {
      "Effect": "Deny", "Action": "*", "Resource": [
        "arn:aws:ses:*:YOUR_AWS_ACCOUNT_ID:configuration-set/opensend-042df6f752eaa1f62cb8-*",
        "arn:aws:sns:*:YOUR_AWS_ACCOUNT_ID:opensend-042df6f752eaa1f62cb8-*",
        "arn:aws:s3:::opensend-042df6f752eaa1f62cb8-*"
      ]
    },
    {
      "Sid": "ProtectAdoptedIdentities", "Effect": "Deny", "NotAction": ["ses:GetEmailIdentity", "ses:SendEmail"],
      "Resource": "arn:aws:ses:us-east-1:YOUR_AWS_ACCOUNT_ID:identity/*"
    },
    {
      "Effect": "Allow", "Action": "ses:GetEmailIdentity", "Resource": "arn:aws:ses:us-east-1:YOUR_AWS_ACCOUNT_ID:identity/?*.??*"
    },
    {
      "Effect": "Allow", "Action": "ses:CreateEmailIdentity", "Resource": ["arn:aws:ses:us-east-1:YOUR_AWS_ACCOUNT_ID:identity/?*.??*", "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:identity/?*.??*"],
      "Condition": {
        "StringLike": {"aws:RequestTag/opensend:domain-claim": "????????-????-4???-????-????????????"},
        "StringEquals": {"aws:RequestTag/opensend:owner": "mx", "aws:RequestTag/opensend:installation-id": "opensend-mx:pool", "aws:RequestTag/opensend:purpose": "domain-identity"},
        "ForAllValues:StringEquals": {"aws:TagKeys": ["opensend:domain-claim", "opensend:owner", "opensend:installation-id", "opensend:purpose"]}
      }
    },
    {
      "Effect": "Allow", "Action": "ses:TagResource", "Resource": ["arn:aws:ses:us-east-1:YOUR_AWS_ACCOUNT_ID:identity/?*.??*", "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:identity/?*.??*"],
      "Condition": {
        "StringLike": {"aws:ResourceTag/opensend:domain-claim": "????????-????-4???-????-????????????"},
        "StringEquals": {"aws:RequestTag/opensend:domain-claim": "${aws:ResourceTag/opensend:domain-claim}", "aws:ResourceTag/opensend:owner": "mx", "aws:ResourceTag/opensend:installation-id": "opensend-mx:pool", "aws:ResourceTag/opensend:purpose": "domain-identity", "aws:RequestTag/opensend:owner": "mx", "aws:RequestTag/opensend:installation-id": "opensend-mx:pool", "aws:RequestTag/opensend:purpose": "domain-identity"},
        "ForAllValues:StringEquals": {"aws:TagKeys": ["opensend:domain-claim", "opensend:owner", "opensend:installation-id", "opensend:purpose"]}
      }
    },
    {
      "Effect": "Allow", "Action": ["ses:PutEmailIdentityMailFromAttributes", "ses:DeleteEmailIdentity", "ses:CreateTenantResourceAssociation", "ses:DeleteTenantResourceAssociation", "ses:ListResourceTenants"],
      "Resource": "arn:aws:ses:us-east-1:YOUR_AWS_ACCOUNT_ID:identity/?*.??*",
      "Condition": {
        "StringLike": {"aws:ResourceTag/opensend:domain-claim": "????????-????-4???-????-????????????"},
        "StringEquals": {"aws:ResourceTag/opensend:owner": "mx", "aws:ResourceTag/opensend:installation-id": "opensend-mx:pool", "aws:ResourceTag/opensend:purpose": "domain-identity"}
      }
    },
    {
      "Effect": "Deny", "Action": "ses:TagResource", "Resource": ["arn:aws:ses:us-east-1:YOUR_AWS_ACCOUNT_ID:configuration-set/opensendmx-trusted-iam-canary", "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/opensendmx-probation-iam-canary"],
      "Condition": {"Null": {"aws:ResourceTag/opensend:run": "true"}}
    },
    {
      "Effect": "Allow", "Action": ["ses:CreateConfigurationSet", "ses:TagResource"],
      "Resource": ["arn:aws:ses:us-east-1:YOUR_AWS_ACCOUNT_ID:configuration-set/opensendmx-trusted-iam-canary", "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/opensendmx-probation-iam-canary"],
      "Condition": {
        "StringEquals": {"aws:RequestTag/opensend:owner": "mx", "aws:RequestTag/opensend:installation-id": "opensend-mx:pool", "aws:RequestTag/opensend:purpose": "release-canary"},
        "StringLike": {"aws:RequestTag/opensend:run": "????????-????-4???-????-????????????"},
        "StringEqualsIfExists": {"aws:ResourceTag/opensend:run": "${aws:RequestTag/opensend:run}", "aws:ResourceTag/opensend:owner": "mx", "aws:ResourceTag/opensend:installation-id": "opensend-mx:pool", "aws:ResourceTag/opensend:purpose": "release-canary"},
        "ForAllValues:StringEquals": {"aws:TagKeys": ["opensend:owner", "opensend:installation-id", "opensend:purpose", "opensend:run"]}
      }
    },
    {
      "Effect": "Allow", "Action": "ses:DeleteConfigurationSet",
      "Resource": ["arn:aws:ses:us-east-1:YOUR_AWS_ACCOUNT_ID:configuration-set/opensendmx-trusted-iam-canary", "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/opensendmx-probation-iam-canary"],
      "Condition": {
        "StringEquals": {"aws:ResourceTag/opensend:owner": "mx", "aws:ResourceTag/opensend:installation-id": "opensend-mx:pool", "aws:ResourceTag/opensend:purpose": "release-canary"},
        "StringLike": {"aws:ResourceTag/opensend:run": "????????-????-4???-????-????????????"}
      }
    }
  ]
}
