{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Deny", "NotAction": "sts:AssumeRole", "Resource": "*",
      "Condition": { "StringNotEquals": { "aws:RequestedRegion": ["us-east-2", "eu-west-1"] } }
    },
    {
      "Effect": "Deny", "Action": ["sns:*Topic*", "sns:*Tag*", "sns:Subscribe", "ses:*Identity*", "ses:*Tenant*", "ses:*ConfigurationSet*", "ses:TagResource", "ses:SendEmail", "ses:*Reputation*"],
      "NotResource": [
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:*", "arn:aws:ses:eu-west-1:YOUR_AWS_ACCOUNT_ID:*",
        "arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:*", "arn:aws:sns:eu-west-1:YOUR_AWS_ACCOUNT_ID:*",
        "arn:aws:ses:us-east-2:aws:reputation-policy/*", "arn:aws:ses:eu-west-1:aws:reputation-policy/*"
      ]
    },
    {
      "Effect": "Deny", "NotAction": "ses:SendEmail", "Resource": "arn:aws:ses:*:*:*@*"
    },
    {
      "Effect": "Allow", "Resource": "*",
      "Action": ["ses:GetAccount", "cloudwatch:GetMetricData", "ses:DescribeActiveReceiptRuleSet", "ses:DescribeReceiptRuleSet", "ses:CreateReceiptRuleSet", "ses:SetActiveReceiptRuleSet", "ses:CreateReceiptRule", "ses:UpdateReceiptRule"]
    },
    {
      "Effect": "Allow", "Action": "ses:ApplyTrackingConfigurationOverrides", "Resource": "*",
      "Condition": { "StringEquals": { "ses:OpenTrackingEnabled": "${ses:ClickTrackingEnabled}" } }
    },
    {
      "Effect": "Allow", "Action": "ses:SendEmail",
      "Resource": ["arn:aws:ses:*:*:identity/*", "arn:aws:ses:*:*:configuration-set/opensend-*"],
      "Condition": { "StringLike": { "ses:TenantName": "opensend-?*" }, "Null": { "ses:MultiRegionEndpointId": "true" } }
    },
    {
      "Effect": "Allow", "Action": ["ses:DeleteEmailIdentity", "ses:PutEmailIdentityMailFromAttributes", "ses:CreateTenantResourceAssociation", "ses:DeleteTenantResourceAssociation", "ses:ListResourceTenants"],
      "Resource": "arn:aws:ses:*:*:identity/?*.??*",
      "Condition": { "StringLike": { "aws:ResourceTag/opensend:domain-claim": "????????-????-4???-????-????????????" } }
    },
    {
      "Effect": "Allow", "Action": ["ses:CreateEmailIdentity", "ses:TagResource"], "Resource": "arn:aws:ses:*:*:identity/?*.??*",
      "Condition": {
        "StringLike": { "aws:RequestTag/opensend:domain-claim": "????????-????-4???-????-????????????" },
        "StringEqualsIfExists": { "aws:ResourceTag/opensend:domain-claim": "${aws:RequestTag/opensend:domain-claim}" },
        "ForAllValues:StringEquals": { "aws:TagKeys": ["opensend:domain-claim"] }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ses:CreateTenantResourceAssociation",
        "ses:GetConfigurationSet", "ses:GetConfigurationSetEventDestinations", "ses:CreateConfigurationSetEventDestination",
        "ses:UpdateConfigurationSetEventDestination", "ses:PutConfigurationSetSuppressionOptions",
        "sns:ListTagsForResource", "sns:SetTopicAttributes", "sns:ListSubscriptionsByTopic"
      ],
      "Resource": [
        "arn:aws:ses:*:*:configuration-set/opensend-mx-transactional",
        "arn:aws:ses:*:*:configuration-set/opensend-mx-marketing",
        "arn:aws:sns:*:*:opensend-mx-feedback", "arn:aws:sns:*:*:opensend-mx-inbound"
      ]
    },
    {
      "Effect": "Allow", "Action": ["sns:GetSubscriptionAttributes", "sns:SetSubscriptionAttributes"],
      "Resource": ["arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:opensend-*-feedback", "arn:aws:sns:eu-west-1:YOUR_AWS_ACCOUNT_ID:opensend-*-feedback"]
    },
    {
      "Effect": "Allow", "Action": ["ses:CreateConfigurationSet", "ses:TagResource", "sns:CreateTopic", "sns:TagResource"],
      "Resource": [
        "arn:aws:ses:*:*:configuration-set/opensend-mx-transactional",
        "arn:aws:ses:*:*:configuration-set/opensend-mx-marketing",
        "arn:aws:sns:*:*:opensend-mx-feedback"
      ],
      "Condition": {
        "StringEquals": { "aws:RequestTag/opensend:installation-id": "opensend-mx:pool", "aws:RequestTag/opensend:purpose": "ses-feedback" },
        "ForAllValues:StringEquals": { "aws:TagKeys": ["opensend:installation-id", "opensend:purpose"] }
      }
    },
    {
      "Effect": "Allow", "Action": ["sns:CreateTopic", "sns:TagResource"], "Resource": "arn:aws:sns:*:*:opensend-mx-inbound",
      "Condition": {
        "StringEquals": { "aws:RequestTag/opensend:installation-id": "opensend-mx:pool", "aws:RequestTag/opensend:purpose": "mailbox-inbound" },
        "ForAllValues:StringEquals": { "aws:TagKeys": ["opensend:installation-id", "opensend:purpose"] }
      }
    },
    {
      "Effect": "Allow", "Action": "sns:Subscribe",
      "Resource": ["arn:aws:sns:*:*:opensend-mx-feedback", "arn:aws:sns:*:*:opensend-mx-inbound"],
      "Condition": { "StringEquals": { "sns:Protocol": "https", "sns:Endpoint": "https://opensend.mx/v1/events/ses" } }
    },
    {
      "Effect": "Allow", "Action": "s3:CreateBucket", "Resource": "arn:aws:s3:::opensend-mx-YOUR_AWS_ACCOUNT_ID-mail-${aws:RequestedRegion}",
      "Condition": { "StringEquals": { "s3:LocationConstraint": "${aws:RequestedRegion}" }, "Null": { "s3:x-amz-object-ownership": "true" } }
    },
    {
      "Effect": "Deny", "Action": ["s3:GetObject", "s3:Put*"], "Resource": "*",
      "Condition": { "StringNotEquals": { "s3:ResourceAccount": "YOUR_AWS_ACCOUNT_ID" } }
    },
    {
      "Effect": "Allow", "Action": ["s3:PutBucketTagging", "s3:PutBucketPublicAccessBlock", "s3:PutBucketPolicy", "s3:PutLifecycleConfiguration", "s3:GetObject", "ses:GetEmailIdentity", "sns:GetTopicAttributes"],
      "Resource": [
        "arn:aws:s3:::opensend-mx-YOUR_AWS_ACCOUNT_ID-mail-${aws:RequestedRegion}",
        "arn:aws:s3:::opensend-mx-YOUR_AWS_ACCOUNT_ID-mail-${aws:RequestedRegion}/staging/?*",
        "arn:aws:s3:::opensend-mx-YOUR_AWS_ACCOUNT_ID-mail-${aws:RequestedRegion}/workspaces/ws_????????????????????????????????/raw/?*.eml",
        "arn:aws:ses:*:*:identity/?*.??*", "arn:aws:sns:*:*:opensend-mx-feedback"
      ]
    },
    {
      "Effect": "Allow", "Action": [
        "s3:GetObject", "s3:PutObject", "ses:CreateTenantResourceAssociation", "ses:CreateTenant", "ses:GetTenant",
        "ses:PutTenantSuppressionAttributes", "ses:UpdateReputationEntityPolicy", "ses:DeleteTenantResourceAssociation"
      ],
      "Resource": [
        "arn:aws:s3:::opensend-mx-YOUR_AWS_ACCOUNT_ID-mail-${aws:RequestedRegion}/workspaces/ws_????????????????????????????????/att/msg_????????????????????????????????/matt_????????????????????????????????",
        "arn:aws:ses:*:*:tenant/opensend-ws_????????????????????????????????/*", "arn:aws:ses:*:aws:reputation-policy/strict"
      ]
    },
    {
      "Effect": "Allow", "Action": ["s3:PutObject", "s3:PutObjectTagging"],
      "Resource": "arn:aws:s3:::opensend-mx-YOUR_AWS_ACCOUNT_ID-mail-${aws:RequestedRegion}/workspaces/ws_????????????????????????????????/raw/?*.eml",
      "Condition": { "StringEquals": { "s3:RequestObjectTag/opensend-kind": "raw" }, "ForAllValues:StringEquals": { "s3:RequestObjectTagKeys": "opensend-kind" } }
    },
    {
      "Effect": "Allow", "Action": "sts:AssumeRole", "Resource": "arn:aws:iam::*:role/OpenSendMX-????????????????????",
      "Condition": { "StringEquals": { "sts:RoleSessionName": "OpenSendMX" }, "StringNotEquals": { "aws:ResourceAccount": "YOUR_AWS_ACCOUNT_ID" } }
    }
  ]
}
