{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyOutsidePoolRegions",
      "Effect": "Deny",
      "NotAction": "sts:AssumeRole",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-2",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "RegionalDiscoveryTrackingAndReceiptRules",
      "Effect": "Allow",
      "Action": [
        "ses:GetAccount",
        "ses:ListEmailIdentities",
        "ses:ListTenants",
        "cloudwatch:GetMetricData",
        "ses:ApplyTrackingConfigurationOverrides",
        "ses:DescribeActiveReceiptRuleSet",
        "ses:DescribeReceiptRuleSet",
        "ses:CreateReceiptRuleSet",
        "ses:SetActiveReceiptRuleSet",
        "ses:CreateReceiptRule",
        "ses:UpdateReceiptRule",
        "ses:DeleteReceiptRule"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TenantOnlySend",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": [
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:identity/*",
        "arn:aws:ses:eu-west-1:YOUR_AWS_ACCOUNT_ID:identity/*",
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/opensend-*",
        "arn:aws:ses:eu-west-1:YOUR_AWS_ACCOUNT_ID:configuration-set/opensend-*"
      ],
      "Condition": {
        "StringLike": {
          "ses:TenantName": "opensend-?*"
        },
        "Null": {
          "ses:MultiRegionEndpointId": "true"
        }
      }
    },
    {
      "Sid": "SenderDomains",
      "Effect": "Allow",
      "Action": [
        "ses:CreateEmailIdentity",
        "ses:DeleteEmailIdentity",
        "ses:TagResource",
        "ses:GetEmailIdentity",
        "ses:PutEmailIdentityMailFromAttributes"
      ],
      "Resource": [
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:identity/*",
        "arn:aws:ses:eu-west-1:YOUR_AWS_ACCOUNT_ID:identity/*"
      ]
    },
    {
      "Sid": "ConfigurationSets",
      "Effect": "Allow",
      "Action": [
        "ses:CreateConfigurationSet",
        "ses:GetConfigurationSet",
        "ses:TagResource",
        "ses:GetConfigurationSetEventDestinations",
        "ses:CreateConfigurationSetEventDestination",
        "ses:UpdateConfigurationSetEventDestination",
        "ses:PutConfigurationSetSuppressionOptions"
      ],
      "Resource": [
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/opensend-*",
        "arn:aws:ses:eu-west-1:YOUR_AWS_ACCOUNT_ID:configuration-set/opensend-*"
      ]
    },
    {
      "Sid": "WorkspaceTenants",
      "Effect": "Allow",
      "Action": [
        "ses:CreateTenant",
        "ses:GetTenant",
        "ses:DeleteTenant",
        "ses:ListTenantResources",
        "ses:PutTenantSuppressionAttributes",
        "ses:ListSuppressedDestinations",
        "ses:GetSuppressedDestination",
        "ses:PutSuppressedDestination",
        "ses:DeleteSuppressedDestination",
        "ses:GetReputationEntity",
        "ses:ListReputationEntities",
        "ses:UpdateReputationEntityCustomerManagedStatus"
      ],
      "Resource": [
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:tenant/opensend-*/*",
        "arn:aws:ses:eu-west-1:YOUR_AWS_ACCOUNT_ID:tenant/opensend-*/*"
      ]
    },
    {
      "Sid": "OnlyStrictReputationPolicy",
      "Effect": "Allow",
      "Action": "ses:UpdateReputationEntityPolicy",
      "Resource": [
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:tenant/opensend-*/*",
        "arn:aws:ses:eu-west-1:YOUR_AWS_ACCOUNT_ID:tenant/opensend-*/*",
        "arn:aws:ses:us-east-2:aws:reputation-policy/strict",
        "arn:aws:ses:eu-west-1:aws:reputation-policy/strict"
      ]
    },
    {
      "Sid": "TenantAssociations",
      "Effect": "Allow",
      "Action": [
        "ses:CreateTenantResourceAssociation",
        "ses:DeleteTenantResourceAssociation",
        "ses:ListResourceTenants"
      ],
      "Resource": [
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:tenant/opensend-*/*",
        "arn:aws:ses:eu-west-1:YOUR_AWS_ACCOUNT_ID:tenant/opensend-*/*",
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:identity/*",
        "arn:aws:ses:eu-west-1:YOUR_AWS_ACCOUNT_ID:identity/*",
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/opensend-*",
        "arn:aws:ses:eu-west-1:YOUR_AWS_ACCOUNT_ID:configuration-set/opensend-*"
      ]
    },
    {
      "Sid": "ProvisionInboundAndFeedbackTopics",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:TagResource",
        "sns:ListTagsForResource",
        "sns:SetTopicAttributes",
        "sns:ListSubscriptionsByTopic"
      ],
      "Resource": [
        "arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:opensend-*-feedback",
        "arn:aws:sns:eu-west-1:YOUR_AWS_ACCOUNT_ID:opensend-*-feedback",
        "arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:opensend-*-inbound",
        "arn:aws:sns:eu-west-1:YOUR_AWS_ACCOUNT_ID:opensend-*-inbound"
      ]
    },
    {
      "Sid": "VerifyFeedbackSubscriptions",
      "Effect": "Allow",
      "Action": [
        "sns:GetTopicAttributes",
        "sns:GetSubscriptionAttributes",
        "sns:SetSubscriptionAttributes"
      ],
      "Resource": [
        "arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:opensend-*-feedback",
        "arn:aws:sns:eu-west-1:YOUR_AWS_ACCOUNT_ID:opensend-*-feedback"
      ]
    },
    {
      "Sid": "SubscribeOnlyMX",
      "Effect": "Allow",
      "Action": "sns:Subscribe",
      "Resource": [
        "arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:opensend-*-feedback",
        "arn:aws:sns:eu-west-1:YOUR_AWS_ACCOUNT_ID:opensend-*-feedback",
        "arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:opensend-*-inbound",
        "arn:aws:sns:eu-west-1:YOUR_AWS_ACCOUNT_ID:opensend-*-inbound"
      ],
      "Condition": {
        "StringEquals": {
          "sns:Protocol": "https",
          "sns:Endpoint": "https://opensend.mx/v1/events/ses"
        }
      }
    },
    {
      "Sid": "CreateRegionalMailboxBucket",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::opensend-*-mail-${aws:RequestedRegion}",
      "Condition": {
        "StringEquals": {
          "s3:LocationConstraint": "${aws:RequestedRegion}",
          "s3:x-amz-object-ownership": "BucketOwnerEnforced"
        }
      }
    },
    {
      "Sid": "ProbeAndSetOwnershipOnCreate",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:PutBucketOwnershipControls"
      ],
      "Resource": "arn:aws:s3:::opensend-*-mail-${aws:RequestedRegion}",
      "Condition": {
        "StringEqualsIfExists": {
          "s3:ResourceAccount": "${aws:PrincipalAccount}"
        }
      }
    },
    {
      "Sid": "ConfigurePrivateMailboxBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketTagging",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketPolicy",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": "arn:aws:s3:::opensend-*-mail-${aws:RequestedRegion}",
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "${aws:PrincipalAccount}"
        }
      }
    },
    {
      "Sid": "ReadMailboxObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::opensend-*-mail-${aws:RequestedRegion}/staging/*",
        "arn:aws:s3:::opensend-*-mail-${aws:RequestedRegion}/workspaces/*/raw/*",
        "arn:aws:s3:::opensend-*-mail-${aws:RequestedRegion}/workspaces/*/att/*"
      ],
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "${aws:PrincipalAccount}"
        }
      }
    },
    {
      "Sid": "WriteMailboxObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:PutObjectTagging"],
      "Resource": [
        "arn:aws:s3:::opensend-*-mail-${aws:RequestedRegion}/workspaces/*/raw/*",
        "arn:aws:s3:::opensend-*-mail-${aws:RequestedRegion}/workspaces/*/att/*"
      ],
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "${aws:PrincipalAccount}"
        }
      }
    },
    {
      "Sid": "AssumeCustomerRoles",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::*:role/OpenSendMX-*"
    }
  ]
}
