{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow", "Action": ["ses:GetAccount", "cloudwatch:GetMetricData"], "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": ["us-east-1", "us-east-2"]}}
    },
    {
      "Effect": "Allow", "Action": "ses:ApplyTrackingConfigurationOverrides", "Resource": "*",
      "Condition": {"StringEquals": {"ses:OpenTrackingEnabled": "${ses:ClickTrackingEnabled}", "aws:RequestedRegion": ["us-east-1", "us-east-2"]}}
    },
    {
      "Effect": "Allow", "Action": "sts:AssumeRole", "Resource": "arn:aws:iam::*:role/OpenSendMX-????????????????????",
      "Condition": {"StringEquals": {"sts:RoleSessionName": "OpenSendMX"}, "StringNotEquals": {"aws:ResourceAccount": "YOUR_AWS_ACCOUNT_ID"}}
    },
    {
      "Effect": "Allow", "Resource": "*",
      "Action": ["ses:DescribeActiveReceiptRuleSet", "ses:DescribeReceiptRuleSet", "ses:CreateReceiptRuleSet", "ses:SetActiveReceiptRuleSet", "ses:CreateReceiptRule", "ses:UpdateReceiptRule"],
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-2" } }
    },
    {
      "Effect": "Allow", "Action": "ses:SendEmail",
      "Resource": ["arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:identity/*", "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/opensend-mx-transactional", "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/opensend-mx-marketing"],
      "Condition": { "StringLike": { "ses:TenantName": ["opensend-ws_????????????????????????????????", "opensendmx-probation-ws_????????????????????????????????"] }, "Null": { "ses:MultiRegionEndpointId": "true" } }
    },
    {
      "Effect": "Allow", "Action": ["ses:DeleteEmailIdentity", "ses:PutEmailIdentityMailFromAttributes", "ses:CreateTenantResourceAssociation", "ses:DeleteTenantResourceAssociation", "ses:ListResourceTenants"],
      "Resource": "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:identity/?*.??*",
      "Condition": { "StringLike": { "aws:ResourceTag/opensend:domain-claim": "????????-????-4???-????-????????????" } }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ses:CreateTenantResourceAssociation",
        "ses:GetConfigurationSet", "ses:GetConfigurationSetEventDestinations", "ses:CreateConfigurationSetEventDestination",
        "ses:UpdateConfigurationSetEventDestination", "ses:PutConfigurationSetSuppressionOptions",
        "sns:ListTagsForResource", "sns:SetTopicAttributes", "sns:ListSubscriptionsByTopic"
      ],
      "Resource": [
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/opensend-mx-transactional",
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/opensend-mx-marketing",
        "arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:opensend-mx-feedback", "arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:opensend-mx-inbound"
      ]
    },
    {
      "Effect": "Allow", "Action": ["sns:GetSubscriptionAttributes", "sns:SetSubscriptionAttributes"],
      "Resource": "arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:opensend-mx-feedback"
    },
    {
      "Effect": "Allow", "Action": ["ses:CreateConfigurationSet", "ses:TagResource", "sns:CreateTopic", "sns:TagResource"],
      "Resource": [
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/opensend-mx-transactional",
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/opensend-mx-marketing",
        "arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:opensend-mx-feedback"
      ],
      "Condition": {
        "StringEquals": { "aws:RequestTag/opensend:installation-id": "opensend-mx:pool", "aws:RequestTag/opensend:purpose": "ses-feedback" },
        "ForAllValues:StringEquals": { "aws:TagKeys": ["opensend:installation-id", "opensend:purpose"] }
      }
    },
    {
      "Effect": "Allow", "Action": ["sns:CreateTopic", "sns:TagResource"], "Resource": "arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:opensend-mx-inbound",
      "Condition": {
        "StringEquals": { "aws:RequestTag/opensend:installation-id": "opensend-mx:pool", "aws:RequestTag/opensend:purpose": "mailbox-inbound" },
        "ForAllValues:StringEquals": { "aws:TagKeys": ["opensend:installation-id", "opensend:purpose"] }
      }
    },
    {
      "Effect": "Allow", "Action": "sns:Subscribe",
      "Resource": ["arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:opensend-mx-feedback", "arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:opensend-mx-inbound"],
      "Condition": { "StringEquals": { "sns:Protocol": "https", "sns:Endpoint": "https://opensend.mx/v1/events/ses" } }
    },
    {
      "Effect": "Allow", "Action": "s3:CreateBucket", "Resource": "arn:aws:s3:::opensend-mx-YOUR_AWS_ACCOUNT_ID-mail-us-east-2",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-2", "s3:LocationConstraint": "us-east-2" }, "Null": { "s3:x-amz-object-ownership": "true" } }
    },
    {
      "Effect": "Deny", "Action": ["s3:GetObject", "s3:Put*"], "Resource": "*",
      "Condition": { "StringNotEquals": { "s3:ResourceAccount": "YOUR_AWS_ACCOUNT_ID" } }
    },
    {
      "Effect": "Allow", "Action": ["s3:PutBucketTagging", "s3:PutBucketPublicAccessBlock", "s3:PutBucketPolicy", "s3:PutLifecycleConfiguration", "s3:GetObject", "ses:GetEmailIdentity", "sns:GetTopicAttributes"],
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-2"}},
      "Resource": [
        "arn:aws:s3:::opensend-mx-YOUR_AWS_ACCOUNT_ID-mail-us-east-2",
        "arn:aws:s3:::opensend-mx-YOUR_AWS_ACCOUNT_ID-mail-us-east-2/staging/?*",
        "arn:aws:s3:::opensend-mx-YOUR_AWS_ACCOUNT_ID-mail-us-east-2/workspaces/ws_????????????????????????????????/raw/?*.eml",
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:identity/?*.??*", "arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:opensend-mx-feedback"
      ]
    },
    {
      "Effect": "Allow", "Action": [
        "s3:GetObject", "s3:PutObject", "ses:CreateTenantResourceAssociation", "ses:GetTenant",
        "ses:PutTenantSuppressionAttributes", "ses:UpdateReputationEntityPolicy", "ses:DeleteTenantResourceAssociation"
      ],
      "Resource": [
        "arn:aws:s3:::opensend-mx-YOUR_AWS_ACCOUNT_ID-mail-us-east-2/workspaces/ws_????????????????????????????????/att/msg_????????????????????????????????/matt_????????????????????????????????",
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:tenant/opensend-ws_????????????????????????????????/*", "arn:aws:ses:us-east-2:aws:reputation-policy/strict"
      ], "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-2"}}
    },
    {
      "Effect": "Allow", "Action": ["s3:PutObject", "s3:PutObjectTagging"],
      "Resource": "arn:aws:s3:::opensend-mx-YOUR_AWS_ACCOUNT_ID-mail-us-east-2/workspaces/ws_????????????????????????????????/raw/?*.eml",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-2", "s3:RequestObjectTag/opensend-kind": "raw" }, "ForAllValues:StringEquals": { "s3:RequestObjectTagKeys": "opensend-kind" } }
    }
  ]
}
